   "id": "7ae6c2f1",
   "source": "# ---------------------------------------------------------\n# 4-3. 배치 업로드 (+ 실패 시 재시도)\n# ---------------------------------------------------------\n# add_documents()의 기본 배치 크기는 64입니다.\n# 한 요청이 커질수록 타임아웃 위험이 커지므로 배치를 작게 나누고,\n# 실패한 배치만 잠시 기다렸다가 재시도합니다.\nBATCH_SIZE = 32   # 네트워크가 느리면 16 또는 8로 줄이세요\nMAX_RETRY = 3\n\n# 문서마다 고정된 ID를 만들어 둡니다.\n# 재시도 시 같은 ID로 덮어쓰므로 중복 저장되지 않습니다.\npoint_ids = [\n    str(uuid5(NAMESPACE_URL, f\"{COLLECTION_NAME}-{i}\"))\n    for i in range(len(split_docs))\n]\n\ntotal = len(split_docs)\nuploaded = 0\n\nfor start in range(0, total, BATCH_SIZE):\n    batch = split_docs[start:start + BATCH_SIZE]\n    batch_ids = point_ids[start:start + BATCH_SIZE]\n\n    for attempt in range(1, MAX_RETRY + 1):\n        try:\n            vectorstore.add_documents(documents=batch, ids=batch_ids)\n            uploaded += len(batch)\n            break\n        except Exception as e:\n            print(f\"\\n  배치 {start}~{start + len(batch)} 실패 \"\n                  f\"({attempt}/{MAX_RETRY}): {type(e).__name__}: {e}\")\n            if attempt == MAX_RETRY:\n                raise\n            time.sleep(2 * attempt)  # 잠시 기다렸다가 재시도\n\n    print(f\"진행률: {uploaded}/{total} ({uploaded / total * 100:.1f}%)\", end=\"\\r\")\n\nprint(f\"\\n\\n✓ Qdrant 적재 완료: 컬렉션 '{COLLECTION_NAME}'에 {uploaded}개 청크 업로드\")\nprint(f\"  컬렉션에 저장된 포인트 수: {client.get_collection(COLLECTION_NAME).points_count}\")",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },

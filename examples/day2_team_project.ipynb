   "source": "# ---------------------------------------------------------\n# 4-4. 커널 재시작 후 재연결 (업로드 없이)\n# ---------------------------------------------------------\n# 커널을 재시작하면 vectorstore 변수가 사라져서\n# 아래 5, 6번 셀에서 NameError: name 'vectorstore' is not defined 가 납니다.\n# 이미 Qdrant에 적재를 끝냈다면 위 4-1~4-3을 다시 돌릴 필요 없이\n# 이 셀 하나만 실행해서 기존 컬렉션에 다시 연결하면 됩니다.\nimport os\nfrom dotenv import load_dotenv\nfrom langchain_openai import OpenAIEmbeddings\nfrom langchain_qdrant import QdrantVectorStore\nfrom qdrant_client import QdrantClient\n\nload_dotenv()\n\nEMBEDDING_MODEL = \"text-embedding-3-small\"   # 4-1과 반드시 같은 모델이어야 합니다\nCOLLECTION_NAME = \"cheongnyeon_anshim_housing\"\n\nclient = QdrantClient(\n    url=os.environ.get(\"QDRANT_URL\"),\n    api_key=os.environ.get(\"QDRANT_API_KEY\"),\n    timeout=120,\n)\n\nif not client.collection_exists(COLLECTION_NAME):\n    raise RuntimeError(\n        f\"컬렉션 '{COLLECTION_NAME}'이 없습니다. 4-1~4-3 셀을 실행해 먼저 적재하세요.\"\n    )\n\nvectorstore = QdrantVectorStore(\n    client=client,\n    collection_name=COLLECTION_NAME,\n    embedding=OpenAIEmbeddings(model=EMBEDDING_MODEL),\n)\n\nprint(f\"✓ 기존 컬렉션 '{COLLECTION_NAME}'에 다시 연결했습니다.\")\nprint(f\"  저장된 포인트 수: {client.get_collection(COLLECTION_NAME).points_count}\")",
